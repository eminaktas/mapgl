{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/master/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "K8s Mapgl",
  "id": "k8s-mapgl-panel",
  "info": {
    "keywords": [
      "node graph",
      "network map",
      "service map",
      "dependency graph",
      "topology",
      "flowchart",
      "diagram",
      "relations",
      "map",
      "geomap",
      "nodegraph",
      "deckgl"
    ],
    "description": "Fork of Mapgl for Kubernetes network maps: ELK layout, node cards, line labels",
    "author": {
      "name": "eminaktas",
      "url": "https://github.com/eminaktas/mapgl"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Repository",
        "url": "https://github.com/eminaktas/mapgl"
      },
      {
        "name": "Upstream (Mapgl by Vadim Pyatakov)",
        "url": "https://github.com/vaduga/mapgl"
      },
      {
        "name": "Upstream documentation",
        "url": "https://mapgl.org/documentation"
      }
    ],
    "screenshots": [
      {
        "name": "Service graph",
        "path": "img/screenshots/screenshot1.png"
      },
      {
        "name": "Node graph",
        "path": "img/screenshots/screenshot2.png"
      },
      {
        "name": "Geomap",
        "path": "img/screenshots/screenshot3.png"
      },
      {
        "name": "Namespaces",
        "path": "img/screenshots/screenshot4.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=11.6.0",
    "plugins": []
  }
}
